# ─────────────────────────────────────────────────────────
# Agente de Notícias — Variáveis de ambiente
# Renomeie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git
# ─────────────────────────────────────────────────────────

# Chave da API Anthropic
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-SEU_TOKEN_AQUI

# E-mail remetente (sua conta Gmail)
EMAIL_FROM=seu_email@gmail.com

# Senha de App do Gmail (NÃO use a senha da sua conta Google)
# Como gerar: myaccount.google.com > Segurança > Verificação em duas etapas
#             > Senhas de app > Selecionar app: Outro > Nome: Agente Noticias
EMAIL_PASS=xxxx xxxx xxxx xxxx

# E-mail destinatário do relatório diário
EMAIL_TO=destinatario@exemplo.com

# Configurações SMTP (padrão Gmail — não é necessário alterar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
